generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum OrderStatus {
  draft
  awaiting_stock
  awaiting_kiot
  kiot_linked
  reserved
  packing
  packed
  waiting_vehicle
  scheduled
  shipped
  delivered
  problem
  cancelled
  returned
}

enum InventoryMovementType {
  purchase_in
  manual_adjustment
  reserve
  release_reservation
  ship
  return_in
  damage_out
  package_consume
  package_produce
}

enum ReconciliationStatus {
  open
  resolved
}

model Product {
  id                String              @id @default(cuid())
  sku               String              @unique
  name              String
  unit              String
  defaultPrice      Int
  distributorPrice  Int?
  packageRule       String?
  description       String?
  imageUrl          String?
  isActive          Boolean             @default(true)
  aliases           ProductAlias[]
  variants          ProductVariant[]
  orderItems        OrderItem[]
  inventoryMovement InventoryMovement[]
  packagingRaw      PackagingBatch[]    @relation("PackagingRawProduct")
  packagingBag      PackagingBatch[]    @relation("PackagingBagProduct")
  packagingFinished PackagingBatch[]    @relation("PackagingFinishedProduct")
  weightPerUnitKg   Float               @default(0)
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  @@map("products")
}

model ProductAlias {
  id        String  @id @default(cuid())
  value     String
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, value])
  @@map("product_aliases")
}

model ProductVariant {
  id          String  @id @default(cuid())
  productId   String
  code        String
  cartonCount Int     @default(0)
  tubeCount   Int     @default(0)
  note        String?
  product     Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, code])
  @@map("product_variants")
}

model Customer {
  id        String   @id @default(cuid())
  kiotCustomerId   Int?     @unique
  kiotCustomerCode String?  @unique
  name      String
  phone     String?
  address   String?
  province  String?
  note      String?
  debt          Float    @default(0)
  totalInvoiced Float    @default(0)
  totalRevenue  Float    @default(0)
  invoiceCount  Int      @default(0)
  customerType  String?
  groups        String?
  lastTradingAt DateTime?
  orders    Order[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("customers")
}

model Order {
  id              String                @id @default(cuid())
  code            String                @unique
  kiotInvoiceCode String?               @unique
  sourceChannel   String
  orderType       String                @default("online")
  status          OrderStatus           @default(awaiting_kiot)
  isOfficial      Boolean               @default(false)
  customerId      String?
  customerName    String
  customerPhone   String?
  customerAddress String?
  receiverName    String?
  receiverPhone   String?
  receiverAddress String?
  province        String?
  codAmount       Int                   @default(0)
  paymentKind     String                @default("debt")
  paymentStatus   String                @default("unpaid")
  promisedSendAt  DateTime?
  note            String?
  rawChat         String?
  workflowChecks  Json?
  customer        Customer?             @relation(fields: [customerId], references: [id])
  items           OrderItem[]
  shipments       Shipment[]
  auditLogs       AuditLog[]
  issues          ReconciliationIssue[]
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  @@map("orders")
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  productId String
  quantity  Float
  unitPrice Int
  enteredQuantity Float?
  enteredUnit String?
  conversionNote String?
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id])

  @@map("order_items")
}

model Shipment {
  id           String   @id @default(cuid())
  orderId      String
  deliveryMode String   @default("truck_share")
  freightPayer String   @default("customer")
  packageCount Int      @default(0)
  estimatedWeightKg Float @default(0)
  driverName   String?
  carrierName  String?
  vehicleCode  String?
  sendDate     DateTime?
  codCollected Int      @default(0)
  note         String?
  order        Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("shipments")
}

model InventoryMovement {
  id        String                @id @default(cuid())
  productId String
  orderId   String?
  packagingBatchId String?
  type      InventoryMovementType
  quantity  Float
  note      String?
  product   Product               @relation(fields: [productId], references: [id])
  packagingBatch PackagingBatch?    @relation(fields: [packagingBatchId], references: [id], onDelete: SetNull)
  createdAt DateTime              @default(now())

  @@map("inventory_movements")
}

model PackagingBatch {
  id                String              @id @default(cuid())
  code              String              @unique
  rawProductId      String
  bagProductId      String
  finishedProductId String
  rawKg             Float
  bagKg             Float
  finishedKg        Float
  note              String?
  rawProduct        Product             @relation("PackagingRawProduct", fields: [rawProductId], references: [id])
  bagProduct        Product             @relation("PackagingBagProduct", fields: [bagProductId], references: [id])
  finishedProduct   Product             @relation("PackagingFinishedProduct", fields: [finishedProductId], references: [id])
  movements         InventoryMovement[]
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  @@map("packaging_batches")
}

model Carrier {
  id        String   @id @default(cuid())
  name      String
  phone     String
  route     String
  note      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("carriers")
}

model AuditLog {
  id        String   @id @default(cuid())
  orderId   String?
  actor     String
  action    String
  reason    String?
  metadata  Json?
  order     Order?   @relation(fields: [orderId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())

  @@map("audit_logs")
}

model ReconciliationIssue {
  id              String               @id @default(cuid())
  orderId          String?
  kiotInvoiceCode String
  customerName     String?
  mismatchType     String
  requiredAction   String
  resolutionNote   String?
  status           ReconciliationStatus @default(open)
  order            Order?               @relation(fields: [orderId], references: [id], onDelete: SetNull)
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  @@map("reconciliation_issues")
}
